%YAML 1.2
---
# A compact TypeScript grammar for gpui-m3 (syntect's default set has none). It covers what a
# chat code block or a read-only viewer needs: keywords, strings and templates, comments,
# numbers, types, decorators and function names.
name: TypeScript
file_extensions: [ts, tsx, mts, cts]
scope: source.ts
contexts:
  main:
    - match: '//.*$\n?'
      scope: comment.line.double-slash.ts
    - match: '/\*'
      push: block_comment
    - match: '"'
      push: double_string
    - match: "'"
      push: single_string
    - match: '`'
      push: template
    - match: '\b(import|export|from|as|default|if|else|for|while|do|switch|case|break|continue|return|throw|try|catch|finally|new|delete|typeof|instanceof|in|of|void|await|async|yield|function|class|extends|implements|interface|type|enum|namespace|module|declare|abstract|public|private|protected|readonly|static|const|let|var|get|set|keyof|infer|is|satisfies|override|super|unique|asserts|accessor)\b'
      scope: keyword.control.ts
    - match: '\bthis\b'
      scope: variable.language.this.ts
    - match: '\b(true|false|null|undefined|NaN|Infinity)\b'
      scope: constant.language.ts
    - match: '\b(string|number|boolean|any|unknown|never|object|symbol|bigint)\b'
      scope: support.type.primitive.ts
    - match: '\b(0[xX][0-9a-fA-F_]+n?|0[bB][01_]+n?|0[oO][0-7_]+n?|\d[\d_]*(\.[\d_]+)?([eE][+-]?\d+)?n?)\b'
      scope: constant.numeric.ts
    - match: '@[A-Za-z_$][\w$]*'
      scope: meta.annotation.ts
    - match: '\b[A-Z][\w$]*\b'
      scope: entity.name.type.ts
    - match: '\b([a-z_$][\w$]*)\s*(?=(<[^<>()]*>)?\()'
      captures:
        1: entity.name.function.ts
  block_comment:
    - meta_scope: comment.block.ts
    - match: '\*/'
      pop: true
  double_string:
    - meta_scope: string.quoted.double.ts
    - match: '\.'
      scope: constant.character.escape.ts
    - match: '"'
      pop: true
    - match: '\n'
      pop: true
  single_string:
    - meta_scope: string.quoted.single.ts
    - match: '\.'
      scope: constant.character.escape.ts
    - match: "'"
      pop: true
    - match: '\n'
      pop: true
  template:
    - meta_scope: string.template.ts
    - match: '\.'
      scope: constant.character.escape.ts
    - match: '\$\{'
      push: interpolation
    - match: '`'
      pop: true
  interpolation:
    - meta_scope: meta.interpolation.ts
    - match: '\}'
      pop: true
    - include: main
